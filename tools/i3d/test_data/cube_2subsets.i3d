<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="cube_2subsets.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="hoplite synthetic test (2x2x2 cube, 2 subsets)" version="1"/>
  </Asset>

  <Files>
  </Files>


  <Materials>
    <Material name="paint_mat" materialId="1" diffuseColor="0.8 0.1 0.1 1">
    </Material>
    <Material name="metal_mat" materialId="2" diffuseColor="0.3 0.3 0.3 1">
    </Material>
  </Materials>


  <Shapes>
    <IndexedTriangleSet name="cube" shapeId="1">
      <Vertices count="24" normal="true" uv0="true" tangent="true">
        <v p="1 -1 1" n="1 0 0" t0="0 0"/>
        <v p="1 -1 -1" n="1 0 0" t0="1 0"/>
        <v p="1 1 -1" n="1 0 0" t0="1 1"/>
        <v p="1 1 1" n="1 0 0" t0="0 1"/>
        <v p="-1 -1 -1" n="-1 0 0" t0="0 0"/>
        <v p="-1 -1 1" n="-1 0 0" t0="1 0"/>
        <v p="-1 1 1" n="-1 0 0" t0="1 1"/>
        <v p="-1 1 -1" n="-1 0 0" t0="0 1"/>
        <v p="-1 1 1" n="0 1 0" t0="0 0"/>
        <v p="1 1 1" n="0 1 0" t0="1 0"/>
        <v p="1 1 -1" n="0 1 0" t0="1 1"/>
        <v p="-1 1 -1" n="0 1 0" t0="0 1"/>
        <v p="-1 -1 -1" n="0 -1 0" t0="0 0"/>
        <v p="1 -1 -1" n="0 -1 0" t0="1 0"/>
        <v p="1 -1 1" n="0 -1 0" t0="1 1"/>
        <v p="-1 -1 1" n="0 -1 0" t0="0 1"/>
        <v p="-1 -1 1" n="0 0 1" t0="0 0"/>
        <v p="1 -1 1" n="0 0 1" t0="1 0"/>
        <v p="1 1 1" n="0 0 1" t0="1 1"/>
        <v p="-1 1 1" n="0 0 1" t0="0 1"/>
        <v p="1 -1 -1" n="0 0 -1" t0="0 0"/>
        <v p="-1 -1 -1" n="0 0 -1" t0="1 0"/>
        <v p="-1 1 -1" n="0 0 -1" t0="1 1"/>
        <v p="1 1 -1" n="0 0 -1" t0="0 1"/>
      </Vertices>
      <Triangles count="12">
        <t vi="0 1 2"/>
        <t vi="0 2 3"/>
        <t vi="4 5 6"/>
        <t vi="4 6 7"/>
        <t vi="8 9 10"/>
        <t vi="8 10 11"/>
        <t vi="12 13 14"/>
        <t vi="12 14 15"/>
        <t vi="16 17 18"/>
        <t vi="16 18 19"/>
        <t vi="20 21 22"/>
        <t vi="20 22 23"/>
      </Triangles>
      <Subsets count="2">
        <Subset firstVertex="0" numVertices="12" firstIndex="0" numIndices="18" materialSlotName="mainColor"/>
        <Subset firstVertex="12" numVertices="12" firstIndex="18" numIndices="18" uvDensity0="0.25"/>
      </Subsets>
    </IndexedTriangleSet>
  </Shapes>

  <Scene>
    <Shape name="cube" shapeId="1" nodeId="1" castsShadows="true" receiveShadows="true" materialIds="1,2"/>
  </Scene>

</i3D>

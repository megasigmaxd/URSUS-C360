                    <modifier type="MOTOR_LOAD" value="0.00" modifiedValue="0.000"/>
                    <modifier type="MOTOR_LOAD" value="0.25" modifiedValue="0.383"/>
                    <modifier type="MOTOR_LOAD" value="0.50" modifiedValue="0.707"/>
                    <modifier type="MOTOR_LOAD" value="0.75" modifiedValue="0.924"/>
                    <modifier type="MOTOR_LOAD" value="1.00" modifiedValue="1.000"/>
                </volume>
                <pitch indoor="1.0" outdoor="1.0">
                    <modifier type="MOTOR_RPM_REAL" value="500" modifiedValue="0.2273"/>
                    <modifier type="MOTOR_RPM_REAL" value="2500" modifiedValue="1.1364"/>
                </pitch>
                <lowpassGain indoor="0.7" outdoor="1.0"/>
            </motor>

            <!-- gearbox whine (native ~20 km/h), placed under the seat; pitch ~ speed/20, louder under load -->
            <gearbox file="sounds/gearboxWhine.ogg" linkNode="soundCabin" linkNodeOffset="0 -1.05 0.3" innerRadius="3" outerRadius="45" fadeIn="0.2" fadeOut="0.3">
                <volume indoor="0.6" outdoor="0.45">
                    <modifier type="SPEED" value="0.5" modifiedValue="0.0"/>
                    <modifier type="SPEED" value="3" modifiedValue="0.25"/>
                    <modifier type="SPEED" value="10" modifiedValue="0.6"/>
                    <modifier type="SPEED" value="20" modifiedValue="0.9"/>
                    <modifier type="SPEED" value="26" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="0.0" modifiedValue="0.7"/>
                    <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="1.0"/>
                </volume>
                <pitch indoor="1.0" outdoor="1.0">
                    <modifier type="SPEED" value="0" modifiedValue="0.45"/>
                    <modifier type="SPEED" value="5" modifiedValue="0.55"/>
                    <modifier type="SPEED" value="20" modifiedValue="1.0"/>
                    <modifier type="SPEED" value="26" modifiedValue="1.3"/>
                </pitch>
            </gearbox>

            <!-- shifting without the clutch (manual + clutch mode); gearGrind.ogg is a one-shot, so play it once per event -->
            <clutchCracking file="sounds/gearGrind.ogg" linkNode="soundCabin" linkNodeOffset="0 -1.05 0.3" loops="1" innerRadius="3" outerRadius="40">
                <volume indoor="0.9" outdoor="0.8"/>
            </clutchCracking>
            <gearEngaged file="sounds/gearShift.ogg" linkNode="soundCabin" linkNodeOffset="0 -1.05 0.3" innerRadius="3" outerRadius="30">
                <volume indoor="0.9" outdoor="0.6"/>
            </gearEngaged>
            <gearDisengaged file="sounds/gearShift.ogg" linkNode="soundCabin" linkNodeOffset="0 -1.05 0.3" innerRadius="3" outerRadius="30" volumeScale="0.6" pitchScale="1.1">
                <volume indoor="0.9" outdoor="0.6"/>
            </gearDisengaged>
            <gearGroupChange file="sounds/gearShift.ogg" linkNode="soundCabin" linkNodeOffset="0 -1.05 0.3" innerRadius="3" outerRadius="30" pitchScale="0.85">
                <volume indoor="0.9" outdoor="0.6"/>
            </gearGroupChange>
        </sounds>

        <dashboards>
            <!-- tachometer (gauge_tacho.dds): 0 rpm at +135 deg, 3000 rpm at -135 deg, around the needle's local Z (dial normal) -->
            <dashboard displayType="ROT" valueType="rpm" node="rpmNeedle" rotAxis="3" minRot="135" maxRot="-135" minValueRot="0" maxValueRot="3000" doInterpolation="true"/>
        </dashboards>
    </motorized>

    <drivable>
        <steeringWheel node="steeringWheel" indoorRotation="600" outdoorRotation="120"/>
    </drivable>

    <cylindered>
        <movingParts>
            <!-- lift rods: local +Z aims at the lower-link pin, Z-scaled to keep contact; updated every frame because the hitch rotationNode does not dirty moving parts -->
            <movingPart node="liftRodLeft" referencePoint="liftRodLeftRef" referenceFrame="liftRodLeft" scaleZ="true" isActiveDirty="true" maxUpdateDistance="40"/>
            <movingPart node="liftRodRight" referencePoint="liftRodRightRef" referenceFrame="liftRodRight" scaleZ="true" isActiveDirty="true" maxUpdateDistance="40"/>
        </movingParts>
    </cylindered>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" showOnHud="false" showInShop="false" fillTypes="diesel" capacity="70">
                        <exactFillRootNode node="exactFillRootNodeFuel"/>
                        <!-- fuel gauge (lower arc of gauge_small.dds): empty lower-left (+120 deg) via down (+180) to full lower-right (+240) -->
                        <dashboard displayType="ROT" valueType="fillLevel" node="fuelNeedle" rotAxis="3" minRot="120" maxRot="240" minValueRot="0" maxValueRot="70" doInterpolation="true" interpolationSpeed="0.3"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <honk>
        <sound file="sounds/horn.ogg" linkNode="soundMotor" linkNodeOffset="0 0.2 0.7" innerRadius="10" outerRadius="120">
            <volume indoor="0.7" outdoor="1.0"/>
        </sound>
    </honk>

    <ai>
        <agent frontWheelIndices="1 2"/>
        <!-- AIImplement builds the obstacle box in front of the tractor from base/size; no i3d trigger node needed -->
        <collisionTrigger useSize="true"/>
    </ai>

    <foliageBending>
        <bendingNode minX="-0.84" maxX="0.84" minZ="0.70" maxZ="1.45" yOffset="0.4"/>
        <bendingNode minX="-0.92" maxX="0.92" minZ="-1.75" maxZ="-0.38" yOffset="0.6"/>
        <bendingNode minX="-0.35" maxX="0.35" minZ="-0.38" maxZ="0.70" yOffset="0.35"/>
    </foliageBending>

    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="3" fieldMultiplier="2"/>


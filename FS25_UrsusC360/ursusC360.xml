<?xml version="1.0" encoding="utf-8" standalone="no"?>
<vehicle type="tractor" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle.xsd">
    <annotation>Ursus C-360 (1976), FS25 mod by Hoplite for megasigmaxd. Node names follow docs/i3d_nodes.md; sources per block in docs/xml_notes.md.</annotation>

    <storeData>
        <name>C-360</name>
        <specs>
            <power>52</power>
            <maxSpeed>25</maxSpeed>
        </specs>
        <functions>
            <function>$l10n_function_tractor</function>
        </functions>
        <image>store_ursusC360.dds</image>
        <price>28000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>URSUSC360</brand>
        <category>tractorsS</category>
        <shopTranslationOffset>0 0 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_tractor</typeDesc>
        <filename>ursusC360.i3d</filename>
        <size width="1.83" length="3.57" height="2.35" lengthOffset="-0.015"/>
        <speedLimit value="25"/>
        <components>
            <!-- 2340 kg body + 4 wheels (2x0.04 t + 2x0.14 t) = ~2.70 t operating mass; COM gives ~36/64 axle split -->
            <component centerOfMass="0 0.78 -0.25" solverIterationCount="30" mass="2340"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="VEHICLE"/>
        <mapHotspot type="TRACTOR"/>
    </base>

    <wheels>
        <wheelConfigurations>
            <wheelConfiguration name="$l10n_configuration_valueDefault" price="0" saveId="DEFAULT">
                <wheels autoRotateBackSpeed="1.5">
                    <!-- 1: front left, 6.00-16 (steered, not driven, no brake) -->
                    <wheel isLeft="true" hasTireTracks="true" hasParticles="true">
                        <physics repr="wheelFrontLeft" driveNode="wheelFrontLeftVisual" radius="0.365" width="0.17" mass="0.04" restLoad="0.5" rotSpeed="1" tireType="mud" brakeFactor="0" forcePointRatio="0.3" suspTravel="0.05" initialCompression="35" spring="28" damper="14"/>
                    </wheel>
                    <!-- 2: front right -->
                    <wheel isLeft="false" hasTireTracks="true" hasParticles="true">
                        <physics repr="wheelFrontRight" driveNode="wheelFrontRightVisual" radius="0.365" width="0.17" mass="0.04" restLoad="0.5" rotSpeed="1" tireType="mud" brakeFactor="0" forcePointRatio="0.3" suspTravel="0.05" initialCompression="35" spring="28" damper="14"/>
                    </wheel>
                    <!-- 3: rear left, 14.9-28 (driven, braked) -->
                    <wheel isLeft="true" hasTireTracks="true" hasParticles="true">
                        <physics repr="wheelBackLeft" driveNode="wheelBackLeftVisual" radius="0.683" width="0.378" mass="0.14" restLoad="0.9" rotSpeed="0" tireType="mud" brakeFactor="1" forcePointRatio="0.45" suspTravel="0.07" initialCompression="35" spring="36" damper="22"/>
                    </wheel>
                    <!-- 4: rear right -->
                    <wheel isLeft="false" hasTireTracks="true" hasParticles="true">
                        <physics repr="wheelBackRight" driveNode="wheelBackRightVisual" radius="0.683" width="0.378" mass="0.14" restLoad="0.9" rotSpeed="0" tireType="mud" brakeFactor="1" forcePointRatio="0.45" suspTravel="0.07" initialCompression="35" spring="36" damper="22"/>
                    </wheel>
                </wheels>
            </wheelConfiguration>
        </wheelConfigurations>

        <ackermannSteeringConfigurations>
            <ackermannSteering rotSpeed="30" rotMax="38" rotCenterWheel1="3" rotCenterWheel2="4"/>
        </ackermannSteeringConfigurations>
    </wheels>

    <attacherJoints comboDuration="2">
        <!-- 1: rear 3-point hitch, cat. II. Heights/rotations solved from the hitch geometry (see docs/xml_notes.md).
             attacherJointBack is a child of bottomArm, so the rotation offsets (applied about the joint's local Z with the
             same move alpha) equal the bottomArm angles and keep the implement level while lifting. -->
        <attacherJoint node="attacherJointBack" jointType="implement" moveTime="2.5" allowsJointLimitMovement="true" lowerRotationOffset="-10.77" upperRotationOffset="40.91">
            <distanceToGround lower="0.25" upper="0.95"/>
            <rotationNode node="bottomArm" lowerRotation="-10.77 0 0" upperRotation="40.91 0 0"/>
            <rotationNode2 node="liftArm" lowerRotation="-11.52 0 0" upperRotation="42.24 0 0"/>
            <topArm rotationNode="topArm" translationNode="topArmTranslation" referenceNode="topArmReference" zScale="-1"/>
            <schema position="1 0" rotation="0" invertX="false"/>
        </attacherJoint>

        <!-- 2: swinging drawbar -->
        <attacherJoint node="attacherJointTrailerLow" jointType="trailerLow" lowerRotLimit="25 52 50" allowsJointLimitMovement="false" allowsLowering="false">
            <schema position="1 0" rotation="0" invertX="false"/>
        </attacherJoint>

        <!-- 3: upper transport hitch -->
        <attacherJoint node="attacherJointTrailer" jointType="trailer" lowerRotLimit="25 52 50" allowsJointLimitMovement="false" allowsLowering="false">
            <schema position="1 0" rotation="0" invertX="false"/>
        </attacherJoint>

        <sounds>
            <!-- sounds.json: pump loop is ~6-14 dB hotter (RMS) than the engine loops -->
            <hydraulic file="sounds/hydraulicPump.ogg" linkNode="soundCabin" linkNodeOffset="0 -0.75 -0.45" loops="0" innerRadius="3" outerRadius="40" fadeIn="0.1" fadeOut="0.25">
                <volume indoor="0.45" outdoor="0.5"/>
            </hydraulic>
        </sounds>
    </attacherJoints>

    <powerTakeOffs>
        <!-- independent 540 PTO; ptoMotorRpmRatio 3.69 = 2000 engine rpm at 540 PTO rpm -->
        <output outputNode="ptoBack" attacherJointNodes="attacherJointBack attacherJointTrailerLow attacherJointTrailer"/>
    </powerTakeOffs>

    <lights>
        <states>
            <state lightTypes="0"/>
            <state lightTypes="0 1"/>
        </states>

        <realLights>
            <low>
                <light node="frontLightLeft" lightTypes="0"/>
                <light node="frontLightRight" lightTypes="0"/>
                <light node="workLightBack" lightTypes="1"/>
            </low>
            <high>
                <light node="frontLightLeft" lightTypes="0"/>
                <light node="frontLightRight" lightTypes="0"/>
                <light node="tailLightLeft" lightTypes="0"/>
                <light node="tailLightRight" lightTypes="0"/>
                <light node="workLightBack" lightTypes="1"/>
                <brakeLight node="brakeLightLeft"/>
                <brakeLight node="brakeLightRight"/>
                <turnLightLeft node="turnLightLeftFront"/>
                <turnLightLeft node="turnLightLeftBack"/>
                <turnLightRight node="turnLightRightFront"/>
                <turnLightRight node="turnLightRightBack"/>
            </high>
        </realLights>
    </lights>

    <enterable>
        <exitPoint node="exitPoint"/>
        <enterReferenceNode node="enterReferenceNode" interactionRadius="4"/>

        <cameras>
            <!-- translation/rotation override the i3d so the camera sits on the target's +Z (target yawed 180 deg), the convention VehicleCamera's terrain clipping expects -->
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true" rotMinX="-1.4" rotMaxX="1" transMin="3.5" transMax="30" translation="0 0 7.5" rotation="-18 180 0"/>
            <camera node="indoorCamera" rotatable="true" limit="true" rotMinX="-1.1" rotMaxX="0.5" transMin="0" transMax="0" isInside="true"/>
        </cameras>

        <characterNode node="playerSkin" cameraMinDistance="0.5">
            <target ikChain="leftArm" targetNode="leftHandTarget"/>
            <target ikChain="rightArm" targetNode="rightHandTarget"/>
            <target ikChain="leftFoot" targetNode="leftFootTarget"/>
            <target ikChain="rightFoot" targetNode="rightFootTarget"/>
        </characterNode>
    </enterable>

    <suspensions>
        <!-- no cab/seat suspension on the C-360: only the driver's torso sways -->
        <suspension useCharacterTorso="true" weight="90" minRotation="0 -6 -6" maxRotation="0 6 6" suspensionParametersY="7 1" suspensionParametersZ="7 1"/>
    </suspensions>

    <motorized>
        <consumerConfigurations>
            <consumerConfiguration>
                <!-- l/h at full load and max rpm on "low" fuel usage (x1.5 medium, x2.5 high); diesel only -->
                <consumer fillUnitIndex="1" usage="12" fillType="diesel"/>
            </consumerConfiguration>
        </consumerConfigurations>

        <differentialConfigurations>
            <differentialConfiguration>
                <differentials>
                    <!-- rear-wheel drive only: front wheels are in no differential -->
                    <differential torqueRatio="0.5" maxSpeedRatio="1.6" wheelIndex1="3" wheelIndex2="4"/>
                </differentials>
            </differentialConfiguration>
        </differentialConfigurations>

        <motorConfigurations>
            <motorConfiguration name="S-4003" hp="52" price="0" consumerConfigurationIndex="1">
                <!-- S-4003: 38.2 kW @ 2200 rpm, 190 Nm @ 1500-1600 rpm, idle 700 rpm; torque in kNm -->
                <motor minRpm="700" maxRpm="2200" maxForwardSpeed="25.4" maxBackwardSpeed="6.3" accelerationLimit="1.5" brakeForce="5" lowBrakeForceScale="0.3" ptoMotorRpmRatio="3.69">
                    <torque rpm="700" torque="0.140"/>
                    <torque rpm="1000" torque="0.170"/>
                    <torque rpm="1200" torque="0.180"/>
                    <torque rpm="1500" torque="0.190"/>
                    <torque rpm="1600" torque="0.190"/>
                    <torque rpm="1800" torque="0.184"/>
                    <torque rpm="2000" torque="0.176"/>
                    <torque rpm="2200" torque="0.166"/>
                </motor>
                <!-- unsynchronised 5-speed box + 2-range reducer = 10F/2R; gear maxSpeed = km/h at 2200 rpm on 14.9/13-28 (factory table) -->
                <transmission gearChangeTime="0.8" autoGearChangeTime="1.2" name="$l10n_info_transmission_manual">
                    <directionChange useGear="true" reverseGearIndex="1" changeTime="0.8"/>
                    <manualShift gears="true" groups="true"/>
                    <groups type="default" changeTime="1.2">
                        <!-- group ratio is a speed factor: reducer 1.116/4.773 = 0.2339 -->
                        <group name="L" ratio="0.2339"/>
                        <group name="H" ratio="1" isDefault="true"/>
                    </groups>
                    <forwardGear maxSpeed="4.773" name="1"/>
                    <forwardGear maxSpeed="7.102" name="2"/>
                    <forwardGear maxSpeed="9.896" name="3"/>
                    <forwardGear maxSpeed="15.192" name="4"/>
                    <forwardGear maxSpeed="25.375" name="5"/>
                    <backwardGear maxSpeed="6.229" name="R"/>
                </transmission>
            </motorConfiguration>
        </motorConfigurations>

        <exhaustEffects>
            <exhaustEffect node="exhaustNode" filename="$data/effects/exhaust/exhaust.i3d" minRpmColor="0.35 0.35 0.37 0.25" maxRpmColor="0.06 0.06 0.07 1.1" minRpmScale="0.1" maxRpmScale="0.55" upFactor="0.75"/>
        </exhaustEffects>
        <exhaustFlap node="exhaustFlap" maxRot="50" rotationAxis="1"/>

        <sounds>
            <motorStart file="sounds/motorStart.ogg" linkNode="soundMotor" innerRadius="4" outerRadius="100">
                <volume indoor="0.8" outdoor="1.0"/>
                <lowpassGain indoor="0.7" outdoor="1.0"/>
            </motorStart>
            <motorStop file="sounds/motorStop.ogg" linkNode="soundMotor" innerRadius="4" outerRadius="100">
